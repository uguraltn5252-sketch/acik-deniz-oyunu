{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foulwake.local/governance/SIM_QA_ATTESTATION_SCHEMA.json",
  "title": "FOULWAKE Simulation QA Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "candidate_commit",
    "baseline_commit",
    "validator_hashes",
    "test_commands",
    "seeds_and_samples",
    "raw_output_hashes",
    "source_render_pdf_traceability",
    "artifact_manifests",
    "physical_test_evidence",
    "blind_human_test_evidence",
    "gate_verdicts",
    "open_issues",
    "overall_verdict",
    "evidence_bundle_sha256"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "validator_hashes": {
      "type": "object",
      "minProperties": 1
    },
    "test_commands": {
      "type": "array",
      "minItems": 1
    },
    "seeds_and_samples": {
      "type": "object"
    },
    "raw_output_hashes": {
      "type": "object",
      "minProperties": 1
    },
    "source_render_pdf_traceability": {
      "type": "object"
    },
    "artifact_manifests": {
      "type": "array",
      "minItems": 1
    },
    "physical_test_evidence": {
      "type": "array",
      "minItems": 1
    },
    "blind_human_test_evidence": {
      "type": "array",
      "minItems": 1
    },
    "gate_verdicts": {
      "type": "object",
      "required": [
        "identity",
        "static",
        "exact_mechanics",
        "regression_fuzz",
        "balance_strategy",
        "social_experience",
        "visual",
        "package"
      ]
    },
    "open_issues": {
      "type": "array"
    },
    "overall_verdict": {
      "enum": [
        "PASS",
        "PASS_WITH_MINOR_ISSUES",
        "FAIL",
        "BLOCKER"
      ]
    },
    "evidence_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
