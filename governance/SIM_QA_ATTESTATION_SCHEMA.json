{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foulwake.local/governance/SIM_QA_ATTESTATION_SCHEMA.json",
  "title": "FOULWAKE Simulation QA Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "candidate_commit",
    "baseline_commit",
    "validator_hashes",
    "test_commands",
    "seeds_and_samples",
    "raw_output_hashes",
    "source_render_pdf_traceability",
    "artifact_manifests",
    "physical_test_evidence",
    "blind_human_test_evidence",
    "gate_verdicts",
    "open_issues",
    "overall_verdict",
    "evidence_bundle_sha256"
  ],
  "properties": {
    "version": {"type": "string"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "validator_hashes": {"type": "object", "minProperties": 1},
    "test_commands": {"type": "array", "minItems": 1},
    "seeds_and_samples": {"type": "object"},
    "raw_output_hashes": {"type": "object", "minProperties": 1},
    "source_render_pdf_traceability": {"type": "object"},
    "artifact_manifests": {"type": "array", "minItems": 1},
    "physical_test_evidence": {"type": "array", "minItems": 1},
    "blind_human_test_evidence": {"type": "array", "minItems": 1},
    "gate_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "static",
        "exact_mechanics",
        "regression_fuzz",
        "balance_strategy",
        "social_experience",
        "art_semantic_review",
        "illustration_text_guard",
        "back_design_and_information_leak",
        "visual_readability",
        "package_and_provenance"
      ],
      "properties": {
        "identity": {"type": "string"},
        "static": {"type": "string"},
        "exact_mechanics": {"type": "string"},
        "regression_fuzz": {"type": "string"},
        "balance_strategy": {"type": "string"},
        "social_experience": {"type": "string"},
        "art_semantic_review": {"type": "string"},
        "illustration_text_guard": {"type": "string"},
        "back_design_and_information_leak": {"type": "string"},
        "visual_readability": {"type": "string"},
        "package_and_provenance": {"type": "string"}
      }
    },
    "open_issues": {"type": "array"},
    "overall_verdict": {"enum": ["PASS", "PASS_WITH_MINOR_ISSUES", "FAIL", "BLOCKER"]},
    "evidence_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
